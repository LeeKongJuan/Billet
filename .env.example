# Môi trường chạy (development | production | test)
NODE_ENV=development
PORT=3000
SESSION_SECRET=billet_super_secret_session_key_32_characters_long
DATA_ENCRYPTION_KEY= # Khóa mã hóa 32-byte (tùy chọn, mặc định sinh từ SESSION_SECRET)

# Mặc định sử dụng SQLite cục bộ để chạy thử nghiệm ngay lập tức không cần cài MySQL
DB_CLIENT=better-sqlite3

# Cấu hình MySQL (Nếu muốn dùng MySQL thay vì SQLite, đổi DB_CLIENT=mysql2 và điền thông tin bên dưới)
# DB_CLIENT=mysql2
# MYSQLHOST=127.0.0.1
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=your_mysql_password
# MYSQLDATABASE=billet
# Hoặc chuỗi kết nối DATABASE_URL nếu triển khai đám mây (Railway, Render...)
# DATABASE_URL=mysql://root:password@host:port/billet

# URL client khi chạy dev với Vite
CLIENT_ORIGIN=http://localhost:5173
